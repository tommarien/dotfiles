#!/usr/bin/env bash

# kitty launched from the Dock has a minimal PATH; kitten lives in homebrew
export PATH=/opt/homebrew/bin:$PATH

read -rp "branch: " branch
[[ -n $branch ]] || exit 0

name=$(basename "$(git gtr go 1)")-${branch//\//-}
name=${name//./_}

SESSION_DIR=${XDG_CACHE_HOME:-$HOME/.cache}/kitty-sessions
mkdir -p "$SESSION_DIR"
session_file=$SESSION_DIR/$name.kitty-session
printf 'new_tab %s\ncd %s\nlaunch %s/bin/scripts/kitty-worktree-create %s\n' "$name" "$PWD" "$HOME" "$branch" > "$session_file"

kitten @ action goto_session "$session_file"
