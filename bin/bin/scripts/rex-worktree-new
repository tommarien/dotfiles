#!/usr/bin/env bash

source $HOME/.zshcommon

read -rp "branch: " branch
[[ -n $branch ]] || exit 0

name=$(basename "$(git gtr go 1)")-${branch//\//-}
name=${name//./_}

# The worktree is created inside the new session, so this overlay closes right away.
session_id=$(rex new "$name" -c "$PWD" --interactive --json -- "$HOME/bin/scripts/kitty-worktree-create" "$branch" | jq -r .session_id)

"$(dirname "$0")/rex-select-session" "$session_id" "$name"
