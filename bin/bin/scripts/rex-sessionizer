#!/usr/bin/env bash

if [[ $# -eq 1 ]]; then
    selected=$1
else
    selected=$(find ~/Projects/tommarien ~/Projects/sinch ~/Exercism/go -mindepth 1 -maxdepth 1 -type d | fzf)
fi

if [[ -z $selected ]]; then
    exit 0
fi

label=$(basename "$selected" | tr . _)

session_id=$(rex ls --json | jq -r --arg label "$label" '[.sessions[] | select(.label == $label)][0].session_id // empty')

if [[ -z $session_id ]]; then
    session_id=$(rex new "$label" -c "$selected" --json | jq -r .session_id)
fi

"$(dirname "$0")/rex-select-session" "$session_id" "$label"
