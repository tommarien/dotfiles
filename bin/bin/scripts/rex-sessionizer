#!/usr/bin/env bash

if [[ $# -eq 1 ]]; then
    selected=$1
else
    selected=$(find ~/Projects/tommarien ~/Projects/sinch ~/Exercism/go -mindepth 1 -maxdepth 1 -type d | fzf)
fi

if [[ -z $selected ]]; then
    exit 0
fi

selected_name=$(basename "$selected" | tr . _)

session_id=$(rex ls --json | jq -r --arg name "$selected_name" '.sessions[] | select(.label == $name) | .session_id')

if [[ -z $session_id ]]; then
    session_id=$(rex new "$selected_name" -c "$selected" --json | jq -r .session_id)
fi

client_id=$(rex client ls --json | jq -r '[.clients[] | select(.info.kind == "app")][0].client_id')

rex -C "$client_id" do session.select session_id="$session_id"
