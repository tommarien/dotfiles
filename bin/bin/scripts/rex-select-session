#!/usr/bin/env bash
# Switch the Rex app this overlay was opened from to a session. Rex only allows
# this with Remote Control on (Settings > Rex Server), so fall back to a hint.
# Usage: rex-select-session <session-id> <label>

client_id=$(rex api call session.list_clients "{\"session_id\":\"$REX_SESSION\"}" |
    jq -r '[.clients[] | select(.info.kind == "app")][0].client_id')

if ! rex -C "$client_id" do session.select session_id="$1" >/dev/null 2>&1; then
    if [[ ! -t 0 ]]; then
        echo "Opened session \"$2\", but switching needs Remote Control (Rex Settings > Rex Server)." >&2
        exit 1
    fi
    printf '\nOpened session "%s".\nTurn on Remote Control in Rex Settings > Rex Server to switch to it automatically.\nPress Return to close.' "$2"
    read -r _
fi
