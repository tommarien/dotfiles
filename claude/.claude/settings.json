{
  "permissions": {
    "allow": [
      "mcp__fff__find_files",
      "mcp__fff__grep",
      "mcp__fff__multi_grep",
      "Bash(/Applications/Bear.app/Contents/MacOS/bearcli search *)",
      "Bash(/Applications/Bear.app/Contents/MacOS/bearcli cat *)",
      "Bash(/Applications/Bear.app/Contents/MacOS/bearcli show *)",
      "Bash(/Applications/Bear.app/Contents/MacOS/bearcli list*)",
      "Bash(/Applications/Bear.app/Contents/MacOS/bearcli tags*)",
      "Bash(/Applications/Bear.app/Contents/MacOS/bearcli search-in *)",
      "Read(/Users/tommar/Library/Mobile Documents/com~apple~CloudDocs/zennotes/**)",
      "Bash(source .envrc)",
      "Bash(git status)",
      "Bash(git status *)"
    ],
    "deny": []
  },
  "model": "sonnet",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/dotfiles/claude/.claude/hooks/bell.sh"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/dotfiles/claude/.claude/hooks/bell.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/dotfiles/claude/.claude/hooks/bell.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "gitlab@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {},
  "outputStyle": "Concise",
  "syntaxHighlightingDisabled": false,
  "effortLevel": "medium",
  "tui": "default",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "theme": "custom:github-plus-dark",
  "voiceEnabled": true,
  "ENABLE_LSP_TOOL": true,
  "advisorModel": "opus"
}
