{
  "permissions": {
    "allow": [
      "mcp__fff__find_files",
      "mcp__fff__grep",
      "mcp__fff__multi_grep",
      "Bash(/Applications/Bear.app/Contents/MacOS/bearcli search *)",
      "Bash(/Applications/Bear.app/Contents/MacOS/bearcli cat *)",
      "Bash(/Applications/Bear.app/Contents/MacOS/bearcli show *)",
      "Bash(/Applications/Bear.app/Contents/MacOS/bearcli list*)",
      "Bash(/Applications/Bear.app/Contents/MacOS/bearcli tags*)",
      "Bash(/Applications/Bear.app/Contents/MacOS/bearcli search-in *)",
      "Read(/Users/tommar/Library/Mobile Documents/com~apple~CloudDocs/zennotes/**)"
    ],
    "deny": []
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${TMUX_AGENT_INDICATOR_DIR:-$HOME/.tmux/plugins/tmux-agent-indicator}\"/scripts/agent-state.sh --agent claude --state off"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${TMUX_AGENT_INDICATOR_DIR:-$HOME/.tmux/plugins/tmux-agent-indicator}\"/scripts/agent-state.sh --agent claude --state running"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${TMUX_AGENT_INDICATOR_DIR:-$HOME/.tmux/plugins/tmux-agent-indicator}\"/scripts/agent-state.sh --agent claude --state needs-input"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${TMUX_AGENT_INDICATOR_DIR:-$HOME/.tmux/plugins/tmux-agent-indicator}\"/scripts/agent-state.sh --agent claude --state done"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "gitlab@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {},
  "syntaxHighlightingDisabled": false,
  "effortLevel": "medium",
  "tui": "default",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "theme": "custom:github-plus-dark",
  "voiceEnabled": true,
  "ENABLE_LSP_TOOL": true
}
