{
  "permissions": {
    "allow": [
      "mcp__fff__find_files",
      "mcp__fff__grep",
      "mcp__fff__multi_grep",
      "Bash(/Applications/Bear.app/Contents/MacOS/bearcli search *)",
      "Bash(/Applications/Bear.app/Contents/MacOS/bearcli cat *)",
      "Bash(/Applications/Bear.app/Contents/MacOS/bearcli show *)",
      "Bash(/Applications/Bear.app/Contents/MacOS/bearcli list*)",
      "Bash(/Applications/Bear.app/Contents/MacOS/bearcli tags*)",
      "Bash(/Applications/Bear.app/Contents/MacOS/bearcli search-in *)",
      "Read(~/Library/Mobile Documents/com~apple~CloudDocs/zennotes/**)",
      "Edit(~/Library/Mobile Documents/com~apple~CloudDocs/zennotes/**)",
      "Bash(source .envrc)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(go vet ./...)",
      "Bash(gofmt -l .)",
      "Bash(pm2 ls)",
      "mcp__claude_ai_Atlassian__getJiraIssue",
      "mcp__nvim__get_targets",
      "mcp__nvim__connect"
    ],
    "deny": [
      "Read(**/.envrc)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "model": "sonnet",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"$HOME/Library/Mobile Documents/com~apple~CloudDocs/zennotes/inbox/claude/MEMORY.md\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/dotfiles/claude/.claude/hooks/bell.sh"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/dotfiles/claude/.claude/hooks/bell.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/dotfiles/claude/.claude/hooks/format.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/dotfiles/claude/.claude/hooks/bell.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "gitlab@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {},
  "outputStyle": "Concise",
  "syntaxHighlightingDisabled": false,
  "effortLevel": "medium",
  "tui": "default",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "theme": "custom:github-plus-dark",
  "voiceEnabled": true,
  "ENABLE_LSP_TOOL": true,
  "advisorModel": "opus"
}
