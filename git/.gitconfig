[credential]
	helper = cache
[user]
	name = Tom Marien
	email = tommarien@gmail.com
[includeIf "gitdir:~/Projects/sinch/"]
    path = ~/Projects/sinch/.gitconfig
[core]
	excludesfile = ~/.gitignore_global
	editor = nvim
        pager = delta
[interactive]
        diffFilter = delta --color-only
[delta]
        navigate = true      # n / N jump between files and hunks
        line-numbers = true
[pull]
	ff = only
[trim]
	bases = develop,master,main,prod
[diff]
	tool = p4mergetool
        algorithm = histogram     # usually cleaner hunks than myers
        colorMoved = default      # moved blocks get a distinct colour
[difftool]
	prompt = false
[difftool "p4mergetool"]
	cmd = /Applications/p4merge.app/Contents/Resources/launchp4merge "$LOCAL" "$REMOTE"
	keepBackup = false
	keepTemporaries = false
	trustExitCode = false
[merge]
	tool = p4mergetool
[mergetool "p4mergetool"]
	cmd = /Applications/p4merge.app/Contents/Resources/launchp4merge "$BASE" "$LOCAL" "$REMOTE" "$MERGED"
	keepBackup = false
	keepTemporaries = false
	trustExitCode = false
	prompt = false
[rerere]
	enabled = true # Reuse recorded resolutions
